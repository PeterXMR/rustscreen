<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declare the USB-accessory capability. Required by the USB Accessory integration
         guide: without it some Android versions return null/empty from
         UsbManager.getAccessoryList() (a candidate cause of the empty-accessoryList symptom
         seen on the live Pixel 6a session), and Play would not filter to capable devices.
         required=true — the whole app is a USB accessory client. -->
    <uses-feature
        android:name="android.hardware.usb.accessory"
        android:required="true" />

    <!-- The decode session runs in a foreground service so the OS does not freeze/kill the cached
         process when the user switches to another app (which stalled the USB read → host reconnect
         storm). connectedDevice is the type for an ongoing USB-accessory link. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Android 13+ gates the status notification (with its Stop action) behind a runtime grant. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="RustScreen"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- singleTop: after the user taps "Allow" on the USB permission dialog, Android
             resumes the EXISTING instance (onNewIntent + onResume) rather than re-running
             onCreate. The activity re-checks the accessory in both, so the fd is never
             dropped (HI-01). -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Launch on USB accessory attach. The action AND the meta-data name are the
                 ACCESSORY constant (NOT the device variant); the resource points at the
                 manufacturer/model/version filter matching aoa.rs IDENTITY (Pitfall 4). -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>

        <!-- Owns the live USB decode session (started from MainActivity once the accessory is
             claimed). foregroundServiceType=connectedDevice keeps the process at foreground
             priority so it is never frozen or low-memory-killed while backgrounded. -->
        <service
            android:name=".SessionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
