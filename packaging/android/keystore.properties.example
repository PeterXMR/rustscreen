# Example release-signing config for the Android APK (P8 scaffold).
#
# Copy this to `android/keystore.properties` and fill in real values, OR set the
# equivalent environment variables (preferred for CI — see the table below). The
# real `android/keystore.properties` and any `*.keystore` are git-ignored — NEVER
# commit a keystore or its passwords.
#
# Property (in android/keystore.properties)  | Environment variable (CI)
# -------------------------------------------+----------------------------------
# storeFile                                  | RUSTSCREEN_KEYSTORE
# storePassword                              | RUSTSCREEN_KEYSTORE_PASSWORD
# keyAlias                                   | RUSTSCREEN_KEY_ALIAS
# keyPassword                                | RUSTSCREEN_KEY_PASSWORD
#
# storeFile is a path relative to the android/app/ module directory.

storeFile=../release.keystore
storePassword=CHANGE_ME
keyAlias=rustscreen
keyPassword=CHANGE_ME
